# hangar-bridge example environment.
# The relay and CLI load .env.local, then .env, without overriding existing
# shell variables. Peer transport selection itself lives in config.json.

# Relay SQLite directory and operator-managed roster.
HANGAR_DATA=./.hangar-data
HANGAR_PEERS_FILE=./peers.json

# Relay bind address. Keep private or put behind a private overlay / mTLS.
PORT=8443
HOST=127.0.0.1

# Operator-managed peers are not auto-purged by default.
HANGAR_INACTIVE_DAYS=0

# CLI fallback for `hangar-bridge send|respond` when --relay is omitted.
HANGAR_RELAY=http://127.0.0.1:8443

# Optional: isolate one peer-agent identity/config tree per project.
# HANGAR_CONFIG_DIR=/absolute/path/to/project-specific/config
